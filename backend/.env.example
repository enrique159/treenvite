NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=treenvite
DB_USER=treenvite
DB_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_CODE_PEPPER=replace-with-a-long-random-value
API_TOKEN_PEPPER=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
# SMTP: dejar SMTP_HOST vacío para usar jsonTransport en desarrollo.
# Ejemplo con servidor SMTP propio externo:
# SMTP_HOST=mail.enriquemarin.xyz
# SMTP_USER=smtp@enriquemarin.xyz
# SMTP_PASS=contraseña-del-servidor-smtp
# SMTP_FROM=Treenvite <no-reply@enriquemarin.xyz>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Treenvite <no-reply@example.com>
